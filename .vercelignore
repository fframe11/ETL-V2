# Root directories to ignore
stress test/**
spark/**
infra/**
data/**
docs/**
services/api/**
services/spark/**
services/consumer/**
.venv/**
venv/**
env/**
ui/**
api/**
n8n/**
backups/**
graphify-out/**
graphify_repo/**
gridgeist_repo/**
ponytail_repo/**
student_course_score_evaluation_dataset/**
presentation_assets/**
scripts/**
.pytest_cache/**
tests/**
.agents/**
airflow/**
user_inputs/**
grafana/**
secrets/**
review/**
nginx/**
.git/**
.github/**
.idea/**
.vscode/**
.superpowers/**
node_modules/**
**/node_modules/**
dist/**
**/dist/**

# Keep services/ui
!services/ui
!services/ui/**
services/ui/node_modules/**
services/ui/dist/**

# Root media & loose files
*.png
*.jpg
*.jpeg
*.txt
*.log
*.exe
*.csv
*.parquet
*.jar
*.jsonl
*.zip
*.tar.gz
*.html
*.py
*.md

# Except frontend files inside services/ui
!services/ui/**/*.html
!services/ui/**/*.png
!services/ui/**/*.svg
!services/ui/**/*.json
!services/ui/**/*.ts
!services/ui/**/*.tsx
!services/ui/**/*.js
!services/ui/**/*.css
!package.json
!vercel.json
