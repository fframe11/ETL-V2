{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm --prefix services/ui run build",
  "outputDirectory": "services/ui/dist",
  "installCommand": "npm --prefix services/ui install",
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://dataserve-api.onrender.com/api/:match*"
    },
    {
      "source": "/healthz",
      "destination": "https://dataserve-api.onrender.com/healthz"
    },
    {
      "source": "/docs",
      "destination": "https://dataserve-api.onrender.com/docs"
    },
    {
      "source": "/openapi.json",
      "destination": "https://dataserve-api.onrender.com/openapi.json"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
