# Elasticsearch Config
ELASTICSEARCH_HOST=
ELASTICSEARCH_PORT=

# Spark Cluster Config
SPARK_MASTER_HOST=
SPARK_MASTER_PORT=

# Observability UI Ports
KIBANA_PORT=
GRAFANA_PORT=

# n8n Orchestrator Port
N8N_PORT=

# Serving API Port
API_PORT=

# RDBMS ingestion (/ingest/rdbms): comma-separated allowlist of hosts this API is allowed
# to connect to. Unset = RDBMS ingestion is disabled. "postgres" is this stack's own DB.
RDBMS_ALLOWED_HOSTS=

# API ingestion (/ingest/api): comma-separated allowlist of hosts the API is allowed to
# fetch from. data.go.th is always allowed (built-in integration). Leave unset to allow
# any host (matches this feature's documented "enter any API URL" behavior) — set this to
# lock ingestion down to known sources in a hardened deployment.
# API_INGEST_ALLOWED_HOSTS=

# Backend session auth (required — the API will refuse to start without these).
# Change ADMIN_PASSWORD before sharing this environment with anyone else.
ADMIN_USERNAME=
ADMIN_PASSWORD=
SESSION_SECRET_KEY=
# Set to true only when this stack is served over HTTPS (session cookie won't be sent
# over plain HTTP if true). This deployment's nginx currently serves plain HTTP.
SESSION_COOKIE_SECURE=

# Shared secret Grafana must send as the X-Webhook-Secret header when calling
# POST /api/v1/system/alert (machine-to-machine, not a logged-in user).
ALERT_WEBHOOK_SECRET=

# Shared secret n8n must send as the X-Service-Key header when calling the
# /api/v1/pipeline/ingest/* endpoints as the ingestion orchestrator.
INGEST_SERVICE_KEY=

# pgAdmin (http://localhost:PGADMIN_HOST_PORT)
PGADMIN_HOST_PORT=
PGADMIN_EMAIL=
PGADMIN_PASSWORD=

# PostgreSQL (only applied when the postgres_data volume is first created)
POSTGRES_HOST_PORT=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Elasticsearch superuser password (required; used by elasticsearch, api, spark)
ELASTIC_PASSWORD=
ELASTICSEARCH_PASSWORD=

# Shared secret the api sends to the Spark trigger daemon (X-Trigger-Secret). Required.
TRIGGER_SHARED_SECRET=
# Upload / RDBMS extraction limits
MAX_UPLOAD_MB=200
RDBMS_MAX_ROWS=1000000
# Run Delta OPTIMIZE/VACUUM once every N table versions (0 = never)
DELTA_OPTIMIZE_EVERY=10

# Optional service groups. Remove a name to run a lighter stack:
#   streaming = kafka + zookeeper (Reddit stream ingestion), ai = ollama, tools = pgadmin
COMPOSE_PROFILES=streaming,ai,tools
